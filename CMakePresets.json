{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer",
      "description": "Default developer configuration with examples and tests enabled.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "LIBHID_BUILD_EXAMPLES": "ON",
        "LIBHID_BUILD_TESTS": "ON",
        "LIBHID_ENABLE_WARNINGS": "ON",
        "LIBHID_INSTALL": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/presets/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "static-release",
      "displayName": "Static Release",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/presets/static-release",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "static-release",
      "configurePreset": "static-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "static-release",
      "configurePreset": "static-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
